<!doctype html>
<html lang="en">
    <head>
    
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, minimal-ui">
    
    <title>{resume.data.name}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/paper-css/0.3.0/paper.css">

    <style is:global>
        @page {
            size: A4;
        }

        /* Remove h1 through h6 styling */
        h1, h2, h3, h4, h5, h6 {
            margin: 0;
            padding: 0;
            font-size: inherit;
            font-weight: normal;
            display: flex;
        }

        body {
            background: #EEEEEE;
            font: 13px "Times New Roman", Times, sans-serif;
            line-height: 1.2;
            margin: 40px 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        em {
            color: #999;
        }

        p {
            line-height: 1.2;
        }

        ul {
            margin-bottom: 0;
        }

        a {
            text-decoration: none;
        }

        #resume {
            padding: .75in .75in;
            background: #fff;
            border: 1px solid #ccc;
            box-shadow: 2px 2px 4px #aaa;
            -webkit-box-shadow: 2px 2px 4px #aaa; /* Keeping this for compatibility with older browsers */
            display: flex;
            flex-direction: column;
        }

        .nameBlock, .contactBlock, .profilesBlock {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
        }

        .skillBlock {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            align-content: flex-start;
        }

        .skillSeparator {
            margin-right: 3px;
        }

        .headerTitle {
            font-weight: bold;
            text-decoration-line: underline;
            margin-right: 3px;
        }

        .blockHeader {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }

        .coursesList {
            width: 28%;
            display: flex;
            flex-direction: column;
        }

        .largeFont {
            font-size: 20px;
        }

        .smallFont {
            font-size: 13px;
        }

        .sectionBlock {
            display: flex;
            width: 100%;
            flex-direction: row;
        }

        .sectionName {
            width: 16%;
            display: flex;
            flex-direction: column;
        }

        .sectionContent {
            width: 84%;
            display: flex;
            flex-direction: column;
        }

        .sectionContent ul {
            padding-left: 20px;
            margin-top: 0;
            list-style-type: circle;
        }

        .sectionContent .title {
            font-weight: bold;
        }

        .sectionContent .date {
            display: flex;
            flex: auto;
            justify-content: flex-end;
        }

        .sectionContent .separator {
            border: 1px dashed #CFCFCF;
            margin-top: 4px;
            margin-bottom: 3px;
        }

        .sectionLine {
            border-style: dashed;
            border-width: 1px;
            border-color: #CFCFCF;
            margin-top: 3px;
            margin-bottom: 7px;
            margin-left: 0;
            margin-right: 0;
        }

        .divider {
            font-weight: bold;
            margin-left: 5px;
            margin-right: 5px;
        }

        .summary {
            margin-top: 6px;
        }

        .jobBlock {
            page-break-inside: avoid;
        }

        .description {
            text-align: justify;
        }

        blockquote.reference {
            margin: 0 0 1em;
        }

        /* Media Queries */

        @media only screen and (max-width: 40em) {
            body {
                margin: 0;
                font-size: 14px;
            }
            #resume {
                padding: 0.5em 1em;
                border: none;
            }
            .sectionBlock {
                flex-direction: column;
            }
            .sectionContent {
                width: 100%;
            }
            .sectionContent .date {
                padding-right: 2em;
            }
            .sectionName {
                width: auto;
            }
            /* .largeFont {
                font-size: 20px;
            }
            .smallFont {
                font-size: 14px;
            } */
        }

        @media print {
            body {
                background: #FFFFFF;
                margin: 0;
            }
            #resume {
                padding: .75in;
                border: 0;
                max-width: 100%;
                background: #fff;
                box-shadow: none;
                -webkit-box-shadow: none; /* Keeping this for compatibility with older browsers */
            }
            /* a {
                color: black;
            } */

            /* .sectionName {
                width: 14%;
            }

            .sectionContent {
                width: 86%;
            } */
        }
    </style>
    
    </head>
    <body class="A4">
    
    <div id="resume" class="sheet">
        {mergedResume.data.basics && <Basics basics={mergedResume.data.basics}/>}
        {mergedResume.data.education && <Education education={mergedResume.data.education}/>}
        {mergedResume.data.skills && <Skills skills={mergedResume.data.skills}/>}
        {mergedResume.data.work && <Work work={mergedResume.data.work}/>}
        {mergedResume.data.publications && <Publications publications={mergedResume.data.publications}/>}
        {mergedResume.data.projects && <Projects projects={mergedResume.data.projects}/>}
        {mergedResume.data.certificates && <Certificates certificates={mergedResume.data.certificates}/>}
        {mergedResume.data.awards && <Awards awards={mergedResume.data.awards}/>}
        {mergedResume.data.volunteer && <Volunteer volunteer={mergedResume.data.volunteer}/>}
        {mergedResume.data.languages && <Languages languages={mergedResume.data.languages}/>}
        {mergedResume.data.interests && <Interests interests={mergedResume.data.interests}/>}
        {mergedResume.data.references && <References references={mergedResume.data.references}/>}
    </div>
</html>
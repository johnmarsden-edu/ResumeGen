---
interface Props {
    startDate: string | undefined,
    endDate: string | undefined
}
import { formatDateString } from '../helpers/helpers.js';
const { startDate, endDate = null } = Astro.props;
---
{startDate && <span class="date">{formatDateString(startDate)} &ndash; {endDate ? formatDateString(endDate) : "Present"}</span>}
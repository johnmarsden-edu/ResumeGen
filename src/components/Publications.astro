{publications.length > 0 && (
  <>
    <div class='sectionLine'></div>
    <section id='publications'>
      <h2 class='sectionName'>
        <span>PUBLICATIONS</span>
      </h2>
      <div class='sectionContent'>
        {publications.map((publication, index) => (
          <>
            <article class='blockHeader'>
              <h3 class='headerTitle' set:html={publication.name}></h3>
              <Date date={publication.releaseDate} />
            </article>
            {publication.publisher && (
              <div class="publisher" set:html={publication.publisher}></div>
            )}
            {publication.url && (
              <div class='url'>
                <a href={publication.url} set:html={publication.url}></a>
              </div>
            )}
            {publication.summary && (
              <div class="summary">
                <p set:html={publication.summary}></p>
              </div>
            )}
            {index < publications.length - 1 && <div class='separator'></div>}
          </>
        ))}
      </div>
    </section>
  </>
)}